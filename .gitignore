__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
*.egg
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Results are generated, not committed. Committed exceptions: the report,
# figures, and the tiny per-seed metrics_*.json that back the n=11 headline
# (so the result reproduces on a fresh clone; raw logs/checkpoints stay out).
results/*/**
!results/*/**/
!results/**/metrics_*.json
!results/REPORT.md
!results/*.png

# Trajectory data. Manifests (dataset.json, *.meta.json) are tracked; the
# parquet bytes are not. Fixtures and scientific data are separate trees and
# ashfall.datasets refuses one where the other is required.
data/failures/
data/fixtures/**/*.parquet
data/scientific/**/*.parquet

# IDE
.vscode/
.idea/

# Preserved historical evidence and portable software-validation artifacts.
!results/legacy_row0_curriculum/**
!results/software_validation/**
